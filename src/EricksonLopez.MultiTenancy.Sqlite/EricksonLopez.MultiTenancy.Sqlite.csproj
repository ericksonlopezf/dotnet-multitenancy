<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <Description>SQLite multi-tenant integration for EricksonLopez.MultiTenancy. Provides database-per-tenant dynamic connection string resolution, session temporary context, and transaction management with Microsoft.Data.Sqlite and Dapper.</Description>
    <PackageTags>$(CommonPackageTags);sqlite;database-per-tenant;multi-database;database-isolation;dapper;sql;native-aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.MultiTenancy.Abstractions\EricksonLopez.MultiTenancy.Abstractions.csproj" />
  </ItemGroup>

</Project>
