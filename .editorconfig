# Top-most EditorConfig file
root = true

# All files
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# XML / Props / Targets / Config
[*.{xml,props,targets,config,nuspec,slnx}]
indent_size = 2

# JSON / YAML
[*.{json,yml,yaml}]
indent_size = 2

# C# files
[*.cs]
indent_size = 4

# ─── Language Conventions ──────────────────────────────────────────────────
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning

# ─── Naming Rules & IDE1006 ────────────────────────────────────────────────
dotnet_naming_rule.interface_should_be_prefixed_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_prefixed_with_i.style = prefix_with_i
dotnet_naming_rule.interface_should_be_prefixed_with_i.severity = warning

dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.applicable_accessibilities = *
dotnet_naming_style.prefix_with_i.required_prefix = I
dotnet_naming_style.prefix_with_i.capitalization = pascal_case

dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.types_should_be_pascal_case.severity = warning

dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, record, delegate
dotnet_naming_symbols.types.applicable_accessibilities = *
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_rule.non_public_fields_should_be_camel_case_with_underscore.symbols = non_public_fields
dotnet_naming_rule.non_public_fields_should_be_camel_case_with_underscore.style = camel_case_with_underscore_style
dotnet_naming_rule.non_public_fields_should_be_camel_case_with_underscore.severity = suggestion

dotnet_naming_symbols.non_public_fields.applicable_kinds = field
dotnet_naming_symbols.non_public_fields.applicable_accessibilities = private, protected, internal, protected_internal
dotnet_naming_style.camel_case_with_underscore_style.required_prefix = _
dotnet_naming_style.camel_case_with_underscore_style.capitalization = camel_case

# ─── Roslyn Analyzers & Compiler Diagnostics ───────────────────────────────
# IDE1006: Naming Rule Violations
dotnet_diagnostic.IDE1006.severity = warning

# CA1707: Identifiers should not contain underscores
dotnet_diagnostic.CA1707.severity = warning

# CA1852: Seal internal types
dotnet_diagnostic.CA1852.severity = warning

# CA1305: Specify IFormatProvider
dotnet_diagnostic.CA1305.severity = warning

# CS0618: Member is obsolete (Warning) -> Zero Tolerance: Treat as Error
dotnet_diagnostic.CS0618.severity = error

# CS0619: Member is obsolete (Error) -> Error
dotnet_diagnostic.CS0619.severity = error

# CS1591: Missing XML comment for publicly visible type or member
dotnet_diagnostic.CS1591.severity = warning

# xUnit1051: CancellationToken / Overload usage in tests
dotnet_diagnostic.xUnit1051.severity = warning

# ─── Test Project Specific Overrides ──────────────────────────────────────
[tests/**/*.cs]
# Allow test method naming and fixture patterns
dotnet_diagnostic.IDE1006.severity = none
# Allow underscores in unit test method names (e.g., Given_When_Then)
dotnet_diagnostic.CA1707.severity = none
# Public test methods & classes do not require XML documentation comments
dotnet_diagnostic.CS1591.severity = none
# Test fixtures and test base classes do not strictly need sealing
dotnet_diagnostic.CA1852.severity = none
# Safe evaluation for test assertions and fakes
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1861.severity = none

# ─── Showcase Samples Overrides ───────────────────────────────────────────
[samples/**/*.cs]
dotnet_diagnostic.IDE1006.severity = none
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1852.severity = none
