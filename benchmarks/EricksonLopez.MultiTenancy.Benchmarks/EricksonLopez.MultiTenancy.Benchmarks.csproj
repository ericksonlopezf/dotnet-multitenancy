<Project Sdk="Microsoft.NET.Sdk">
  <!-- Copyright © Erickson Lopez. MIT License. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Benchmarks are not AOT-compatible due to BenchmarkDotNet internals -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <!-- Benchmark methods use underscores for readability and cannot be static -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1707;CA1822;CA1305;CS1591;CA1716;CA1000;CA1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EricksonLopez.MultiTenancy.Abstractions\EricksonLopez.MultiTenancy.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.MultiTenancy\EricksonLopez.MultiTenancy.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.MultiTenancy.AspNetCore\EricksonLopez.MultiTenancy.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.MultiTenancy.Authentication\EricksonLopez.MultiTenancy.Authentication.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.MultiTenancy.Configuration\EricksonLopez.MultiTenancy.Configuration.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.MultiTenancy.Dapper\EricksonLopez.MultiTenancy.Dapper.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.MultiTenancy.OpenTelemetry\EricksonLopez.MultiTenancy.OpenTelemetry.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.MultiTenancy.PostgreSql\EricksonLopez.MultiTenancy.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.MultiTenancy.SqlServer\EricksonLopez.MultiTenancy.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.MultiTenancy.Testing\EricksonLopez.MultiTenancy.Testing.csproj" />
  </ItemGroup>
</Project>
