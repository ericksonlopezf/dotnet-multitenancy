<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <Description>MariaDB multi-tenant isolation and session variable integration for EricksonLopez.MultiTenancy. Provides transaction and connection-level tenant isolation for MariaDB using MySqlConnector and Dapper.</Description>
    <PackageTags>$(CommonPackageTags);mariadb;session-variables;database-isolation;dapper;sql;native-aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.MultiTenancy.Abstractions\EricksonLopez.MultiTenancy.Abstractions.csproj" />
  </ItemGroup>

</Project>
